{
    "expo":  {
                 "name":  "学生综合管理平台",
                 "slug":  "class-schedule",
                 "version": "1.16.2",
                 "orientation":  "portrait",
                 "icon":  "./assets/images/student-icon.png",
                 "scheme":  "classschedule",
                 "userInterfaceStyle":  "automatic",
                 "ios":  {
                             "icon":  "./assets/expo.icon"
                         },
                 "android":  {
                                 "package":  "com.classhoke.classschedule",
                                 "usesCleartextTraffic":  true,
                                 "permissions":  [
                                                     "REQUEST_INSTALL_PACKAGES",
                                                     "SCHEDULE_EXACT_ALARM",
                                                     "USE_EXACT_ALARM",
                                                     "POST_NOTIFICATIONS",
                                                     "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
                                                     "MANAGE_EXTERNAL_STORAGE",
                                                     "READ_EXTERNAL_STORAGE",
                                                     "WRITE_EXTERNAL_STORAGE"
                                                 ],
                                 "adaptiveIcon":  {
                                                      "backgroundColor":  "#1E88E5",
                                                      "foregroundImage":  "./assets/images/student-icon.png"
                                                  },
                                 "predictiveBackGestureEnabled":  false
                             },
                 "web":  {
                             "favicon":  "./assets/images/favicon.png",
                             "output":  "single"
                         },
                 "plugins":  [
                                 "expo-router",
                                 [
                                     "expo-splash-screen",
                                     {
                                         "backgroundColor":  "#208AEF",
                                         "image":  "./assets/images/student-icon.png",
                                         "imageWidth":  140
                                     }
                                 ],
                                 "expo-sharing",
                                 "expo-screen-orientation",
                                 "expo-image",
                                 "expo-web-browser",
                                 "react-native-bottom-tabs",
                                 [
                                     "react-native-android-widget",
                                     {
                                         "widgets": [
                                             {
                                                 "name": "ClassScheduleWidget",
                                                 "label": "今日课程",
                                                 "description": "今天剩余课程与下一节课倒计时",
                                                 "minWidth": "250dp",
                                                 "minHeight": "110dp",
                                                 "targetCellWidth": 4,
                                                 "targetCellHeight": 2,
                                                 "resizeMode": "horizontal|vertical",
                                                 "updatePeriodMillis": 1800000,
                                                 "widgetCategory": "home_screen"
                                             }
                                         ]
                                     }
                                 ],
                                 [
                                     "expo-build-properties",
                                     {
                                         "android": {
                                             "usesCleartextTraffic": true
                                         }
                                     }
                                 ]
                             ],
                 "experiments":  {
                                     "typedRoutes":  true,
                                     "reactCompiler":  true
                                 },
                 "extra":  {
                               "router":  {

                                          },
                               "eas":  {
                                           "projectId":  "afa3fdf7-f1df-4b0c-94b8-ed54ef696a46"
                                       }
                           },
                 "owner":  "zhaoheming"
             }
}
